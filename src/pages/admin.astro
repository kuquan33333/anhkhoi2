
---
const title = "Admin · Anh Khôi AI Media";
---
<!doctype html>
<html lang="vi" class="ak-admin-root">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <link rel="icon" href="/favicon-ak.png" sizes="64x64" />
  <title>{title}</title>
  <style is:inline>
    html.ak-admin-root{font-family:Inter,Roboto,system-ui,sans-serif;color-scheme:dark;background:#07101f;color:#edf5ff}
    .ak-admin-page,.ak-admin-page *{box-sizing:border-box}body.ak-admin-page{margin:0;background:radial-gradient(circle at 20% 0,#173367 0,#07101f 34rem);min-height:100vh;color:#edf5ff}
    button,input,textarea,select{font:inherit}.wrap{max-width:1180px;margin:auto;padding:24px}.brand{display:flex;gap:12px;align-items:center;margin-bottom:22px}
    .brand img{width:42px;height:42px;border-radius:12px}.brand b{font-size:20px}.muted{color:#8da1bb}.card{background:#0c1729e8;border:1px solid #ffffff14;border-radius:18px;padding:18px;box-shadow:0 18px 50px #0005}
    .login{max-width:430px;margin:10vh auto}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.col6{grid-column:span 6}.col12{grid-column:span 12}
    label{display:block;font-size:13px;color:#a8bad0;margin:10px 0 6px}input,textarea,select{width:100%;background:#07111f;border:1px solid #ffffff1f;color:#f7fbff;border-radius:10px;padding:11px}
    textarea{min-height:120px;resize:vertical}.btn{border:0;border-radius:10px;padding:10px 14px;cursor:pointer;background:#2e6df6;color:#fff;font-weight:750}.btn.alt{background:#172740}.btn.danger{background:#8c2b3e}
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}.pill{display:inline-flex;padding:5px 9px;border-radius:999px;background:#142b4d;color:#8dc5ff;font-size:12px}
    table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid #ffffff12;vertical-align:top}th{color:#83a6ce}.scroll{overflow:auto;max-height:470px}
    .ok{color:#65d79d}.warn{color:#ffcf66}.bad{color:#ff7c91}.hidden{display:none!important}.switch{display:flex;gap:8px;align-items:center;margin:7px 0}.switch input{width:auto}
    h2{font-size:17px;margin:0 0 12px}h3{font-size:14px;margin:16px 0 6px}.toolbar{position:sticky;top:0;z-index:5;background:#07101fe8;backdrop-filter:blur(15px);padding:12px 0;margin-bottom:14px}
    .media-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.media-item{border:1px solid #ffffff14;border-radius:12px;overflow:hidden;background:#07111f}.media-item img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}.media-actions{display:flex;gap:6px;flex-wrap:wrap;padding:8px}.media-actions button{font-size:11px;padding:6px 8px}.post-row{padding:9px 0;border-bottom:1px solid #ffffff12}.post-row:last-child{border-bottom:0}.cover-preview{width:100%;max-height:180px;object-fit:cover;border-radius:10px;margin-top:8px;background:#07111f}.mini{font-size:12px;padding:7px 9px}.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.stat{background:#07111f;border:1px solid #ffffff12;border-radius:12px;padding:12px}.stat strong{display:block;font-size:22px}.stat span{font-size:11px;color:#8da1bb}.editorial-warnings{margin-top:12px;padding:11px 12px;border:1px solid #ffcf6647;background:#6a4a161f;border-radius:10px}.editorial-warnings ul{margin:0;padding-left:18px}.editorial-warnings li{margin:4px 0;color:#ffd98a}.editorial-warnings .bad{color:#ff9dad}.editorial-warnings .review{color:#8dc5ff}
    @media(max-width:760px){.wrap{padding:14px}.col6{grid-column:span 12}.card{padding:14px}th:nth-child(3),td:nth-child(3){display:none}.media-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>
</head>
<body class="ak-admin-page">
<div class="wrap">
  <div class="brand"><img src="/favicon-ak.png" alt=""><div><b>Anh Khôi AI Media</b><div class="muted">Quản trị nội dung & đồng bộ Facebook</div></div></div>

  <section id="loginView" class="card login">
    <h2>Đăng nhập quản trị</h2>
    <form id="loginForm">
      <label>Tài khoản</label><input id="username" autocomplete="username" />
      <label>Mật khẩu</label><input id="password" type="password" autocomplete="current-password" />
      <div class="row" style="margin-top:14px"><button class="btn">Đăng nhập</button><span id="loginMsg" class="muted"></span></div>
    </form>
  </section>

  <main id="dashboard" class="hidden">
    <div class="toolbar row between">
      <div class="row"><span class="pill" id="who"></span><span id="health" class="muted">Đang tải…</span></div>
      <div class="row"><a href="/" class="btn alt" style="text-decoration:none">Xem website</a><button id="logoutBtn" class="btn alt">Đăng xuất</button></div>
    </div>

    <div class="grid">
      <section class="card col12">
        <div class="row between"><h2>Tổng quan hệ thống</h2><span id="lastSyncText" class="muted"></span></div>
        <div class="stats">
          <div class="stat"><strong id="statReels">—</strong><span>Reel đã lưu</span></div>
          <div class="stat"><strong id="statCaptions">—</strong><span>Reel có caption</span></div>
          <div class="stat"><strong id="statCached">—</strong><span>Thumbnail đã cache R2</span></div>
          <div class="stat"><strong id="statPosts">—</strong><span>Bài thủ công</span></div>
          <div class="stat"><strong id="statMedia">—</strong><span>Ảnh Admin trên R2</span></div>
        </div>
      </section>
      <section class="card col6">
        <div class="row between"><h2>Đồng bộ Facebook</h2><div class="row"><button id="enrichBtn" class="btn alt">Bổ sung caption</button><button id="syncBtn" class="btn">Đồng bộ ngay</button></div></div>
        <div id="settings"></div>
        <div class="row" style="margin-top:12px"><button id="saveSettings" class="btn alt">Lưu cài đặt</button><span id="settingsMsg" class="muted"></span></div>
      </section>

      <section class="card col6">
        <h2>Đổi mật khẩu</h2>
        <form id="passwordForm">
          <label>Mật khẩu hiện tại</label><input id="currentPassword" type="password" autocomplete="current-password" />
          <label>Mật khẩu mới (tối thiểu 10 ký tự)</label><input id="newPassword" type="password" autocomplete="new-password" />
          <div class="row" style="margin-top:12px"><button class="btn alt">Đổi mật khẩu</button><span id="passwordMsg" class="muted"></span></div>
        </form>
      </section>

      <section class="card col12">
        <h2>Nội dung Facebook đã phát hiện</h2>
        <div class="scroll"><table><thead><tr><th>Ảnh</th><th>Loại / lượt xem</th><th>Nội dung</th><th>Trạng thái</th><th>Facebook</th></tr></thead><tbody id="itemsBody"></tbody></table></div>
      </section>

      <section class="card col6">
        <h2>Lịch sử đồng bộ</h2>
        <div class="scroll"><table><thead><tr><th>Thời gian</th><th>Kết quả</th><th>Mới/Lỗi</th></tr></thead><tbody id="runsBody"></tbody></table></div>
      </section>

      <section class="card col6">
        <div class="row between"><h2 id="manualHeading">Quản lý tất cả bài viết</h2><button id="newPostBtn" class="btn alt mini" type="button">+ Viết bài mới</button></div>
        <form id="manualForm">
          <input id="manualId" type="hidden" />
          <label>Tiêu đề (Tiếng Việt)</label><input id="manualTitle" />
          <label>Tiêu đề tiếng Anh (không bắt buộc)</label><input id="manualTitleEn" />
          <label>Slug (để trống sẽ tự tạo)</label><input id="manualSlug" placeholder="ten-bai-viet" />
          <div class="grid" style="gap:10px">
            <div class="col6"><label>Chuyên mục</label><select id="manualCategory">
              <option value="">Chọn chuyên mục</option>
              <option value="Công nghệ & AI">Công nghệ & AI</option>
              <option value="Khoa học & Khám phá">Khoa học & Khám phá</option>
              <option value="Quân sự & Công nghệ quốc phòng">Quân sự & Công nghệ quốc phòng</option>
              <option value="Du lịch & Trải nghiệm">Du lịch & Trải nghiệm</option>
              <option value="Văn hóa & Sáng tạo">Văn hóa & Sáng tạo</option>
              <option value="Học tập & Kỹ năng số">Học tập & Kỹ năng số</option>
              <option value="Sức khỏe & Đời sống">Sức khỏe & Đời sống</option>
              <option value="Thể thao">Thể thao</option>
              <option value="Góc nhìn & Phân tích">Góc nhìn & Phân tích</option>
            </select></div>
            <div class="col6"><label>Chủ đề (tối đa 5, cách nhau bằng dấu phẩy)</label><input id="manualTags" placeholder="AI, NASA, Thiên văn, An toàn số" /></div>
          <p class="muted" style="font-size:12px;margin:4px 0 10px">Ưu tiên chủ đề dùng lại giữa nhiều bài. Sidebar chỉ hiện các chủ đề được dùng ở ít nhất 2 bài và tối đa 15 chủ đề để tránh tag rác.</p>
          </div>
          <label>Ngôn ngữ</label><select id="manualLanguage"><option value="vi">Tiếng Việt</option><option value="en">English</option></select>
          <label>Mô tả ngắn (Tiếng Việt)</label><input id="manualExcerpt" />
          <label>Mô tả ngắn tiếng Anh (không bắt buộc)</label><input id="manualExcerptEn" />
          <label>Ảnh bìa</label><input id="manualCover" placeholder="Chọn từ thư viện ảnh bên dưới" readonly />
          <img id="manualCoverPreview" class="cover-preview hidden" alt="Ảnh bìa" />
          <label>Nội dung Markdown (Tiếng Việt)</label><textarea id="manualBody" style="min-height:260px"></textarea>
          <label>Nội dung Markdown tiếng Anh (không bắt buộc)</label><textarea id="manualBodyEn" style="min-height:180px"></textarea>

          <label>Nguồn tham khảo — mỗi dòng: Tên nguồn | Tiêu đề/tài liệu | URL | loại</label>
          <textarea id="manualSources" style="min-height:120px" placeholder="NASA | November skywatching guide | https://... | official"></textarea>
          <p class="muted" style="font-size:12px;margin:6px 0">Loại nguồn: official, research, press, industry hoặc reference. URL được lưu nội bộ để kiểm chứng và chỉ hiển thị dưới dạng link gọn.</p>

          <label>Ảnh minh họa có cấu trúc — mỗi dòng: R2 key | alt | caption | credit</label>
          <textarea id="manualMedia" style="min-height:100px" placeholder="admin/.../image.webp | Mô tả ảnh | Chú thích | NASA"></textarea>

          <div class="grid" style="gap:10px">
            <div class="col6"><label>Editorial action</label><select id="manualEditorialAction">
              <option value="KEEP">KEEP — giữ</option>
              <option value="REWRITE">REWRITE — viết lại</option>
              <option value="MOVE">MOVE — chuyển chuyên mục</option>
              <option value="ARCHIVE">ARCHIVE — lưu trữ</option>
              <option value="REMOVE_DUPLICATE">REMOVE_DUPLICATE — bài trùng</option>
            </select></div>
            <div class="col6"><label>Ngày xuất bản</label><input id="manualPublishedAt" type="date" /></div>
          </div>
          <label>Ghi chú biên tập nội bộ</label><textarea id="manualEditorialNotes" style="min-height:80px" placeholder="Điểm cần kiểm chứng, lý do archive, hướng viết lại..."></textarea>
          <label>Trạng thái</label><select id="manualStatus"><option value="draft">Nháp</option><option value="published">Xuất bản</option><option value="archived">Lưu trữ</option></select>
          <div id="manualWarnings" class="editorial-warnings hidden" role="status"></div>
          <div class="row" style="margin-top:12px"><button class="btn">Lưu bài</button><button id="deletePostBtn" class="btn danger hidden" type="button">Lưu trữ bài</button><span id="manualMsg" class="muted"></span></div>
        </form>
        <h3>Tất cả bài viết — sửa, lưu trữ hoặc xuất bản</h3><div id="manualList" class="muted"></div>
      </section>

      <section class="card col12">
        <div class="row between"><h2>Thư viện ảnh R2</h2><span id="mediaMsg" class="muted"></span></div>
        <form id="mediaForm" class="row">
          <input id="mediaFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" style="flex:1;min-width:220px" />
          <button class="btn" type="submit">Upload ảnh</button>
        </form>
        <p class="muted" style="font-size:12px;margin:9px 0 12px">JPEG, PNG, WebP, GIF hoặc AVIF · tối đa 8 MB. Ảnh được lưu vào Cloudflare R2, không commit GitHub.</p>
        <div id="mediaGrid" class="media-grid"></div>
      </section>
    </div>
  </main>
</div>

<script is:inline>
let csrf = sessionStorage.getItem("ak_csrf") || "";
const $ = (s) => document.querySelector(s);

function b64urlBytes(bytes){
  let s=""; for(const b of bytes) s+=String.fromCharCode(b);
  return btoa(s).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/g,"");
}
function b64urlDecode(value){
  let s=String(value||"").replace(/-/g,"+").replace(/_/g,"/");
  while(s.length%4)s+="=";
  return Uint8Array.from(atob(s),ch=>ch.charCodeAt(0));
}
async function deriveLoginProof(password,challenge){
  const passwordKey=await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );
  const bits=await crypto.subtle.deriveBits(
    {
      name:"PBKDF2",
      hash:"SHA-256",
      salt:b64urlDecode(challenge.salt),
      iterations:Number(challenge.iterations)
    },
    passwordKey,
    256
  );
  const hmacKey=await crypto.subtle.importKey(
    "raw",
    bits,
    {name:"HMAC",hash:"SHA-256"},
    false,
    ["sign"]
  );
  const message=new TextEncoder().encode(challenge.challengeId+"."+challenge.nonce);
  const signature=await crypto.subtle.sign("HMAC",hmacKey,message);
  return b64urlBytes(new Uint8Array(signature));
}

async function api(url, options={}) {
  options.headers = {"content-type":"application/json", ...(options.headers||{})};
  if (csrf && options.method && options.method !== "GET") options.headers["x-admin-csrf"] = csrf;
  const r = await fetch(url, options);
  const data = await r.json().catch(()=>({ok:false,error:"invalid_response"}));
  if (r.status===401 && !url.endsWith("/login")) showLogin();
  return {r,data};
}
function showLogin(){ $("#loginView").classList.remove("hidden"); $("#dashboard").classList.add("hidden"); }
function showDash(){ $("#loginView").classList.add("hidden"); $("#dashboard").classList.remove("hidden"); }
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));}
function parsePipeRows(value,kind){
  return String(value||"").split(/\n+/).map(x=>x.trim()).filter(Boolean).map(line=>{
    const p=line.split("|").map(x=>x.trim());
    return kind==="source"
      ? {name:p[0]||"",title:p[1]||"",url:p[2]||"",type:p[3]||"reference"}
      : {key:p[0]||"",alt:p[1]||"",caption:p[2]||"",credit:p[3]||""};
  });
}
function formatPipeRows(items,kind){
  return (Array.isArray(items)?items:[]).map(x=>kind==="source"
    ? [x.name,x.title,x.url,x.type].map(v=>String(v||"").trim()).join(" | ")
    : [x.key,x.alt,x.caption,x.credit].map(v=>String(v||"").trim()).join(" | ")
  ).join("\n");
}
function renderWarnings(items){
  const box=$("#manualWarnings"); const list=Array.isArray(items)?items:[];
  if(!list.length){box.innerHTML="";box.classList.add("hidden");return}
  box.innerHTML="<b>Kiểm tra biên tập</b><ul>"+list.map(w=>'<li class="'+esc(w.severity||"warn")+'">'+esc(w.message||w.code||"Cần kiểm tra")+"</li>").join("")+"</ul>";
  box.classList.remove("hidden");
}
async function saveWithEditorialOverride(url,method,payload){
  let result=await api(url,{method,body:JSON.stringify(payload)});
  if(result.r.status===409&&result.data?.error==="editorial_review_required"){
    renderWarnings(result.data.warnings);
    if(!confirm("Bài còn cảnh báo biên tập. Bạn đã kiểm tra và vẫn muốn xuất bản?")) return result;
    payload={...payload,overrideWarnings:true};
    result=await api(url,{method,body:JSON.stringify(payload)});
  }
  if(result.data?.warnings) renderWarnings(result.data.warnings);
  return result;
}
async function init(){
  const {r,data}=await api("/api/admin/me");
  if(!r.ok){showLogin();return}
  csrf=data.csrfToken;sessionStorage.setItem("ak_csrf",csrf);$("#who").textContent=data.user.username;showDash();
  if(data.user.mustChangePassword) $("#health").innerHTML='<span class="warn">Nên đổi mật khẩu mặc định</span>';
  await refresh();
}
async function refresh(){ await Promise.all([loadStats(),loadSettings(),loadItems(),loadRuns(),loadManual(),loadMedia()]); }
async function loadStats(){
  const {data}=await api("/api/admin/stats");if(!data.ok)return;
  $("#statReels").textContent=data.facebook?.total??0;$("#statCaptions").textContent=data.facebook?.captions??0;
  $("#statCached").textContent=data.facebook?.cached??0;$("#statPosts").textContent=data.posts?.total??0;$("#statMedia").textContent=data.media?.count??0;
  const last=data.lastSync;$("#lastSyncText").textContent=last?("Sync #"+last.id+" · "+last.status+" · "+(last.finished_at||last.started_at)):"Chưa có sync";
}
async function loadSettings(){
  const {data}=await api("/api/admin/settings"); if(!data.ok)return;
  const s=data.settings; $("#settings").innerHTML=[
    ["facebook_sync_enabled","Tự động đồng bộ",true],["facebook_auto_publish","Tự động xuất bản",true],
    ["facebook_feed_visible","Hiển thị feed Facebook công khai",true],["facebook_shadow_mode","Shadow mode (chỉ thu thập, chưa hiện)",true]
  ].map(([k,l])=>'<label class="switch"><input type="checkbox" data-setting="'+k+'" '+(s[k]==="true"?"checked":"")+'> '+l+'</label>').join("")+
  '<label>Giới hạn nội dung mỗi lần</label><input data-setting="crawler_max_items_per_run" type="number" min="10" max="100" value="'+esc(s.crawler_max_items_per_run||"80")+'">'+
  '<label>Độ sâu cuộn mỗi tab Facebook</label><input data-setting="crawler_max_scrolls" type="number" min="4" max="30" value="'+esc(s.crawler_max_scrolls||"14")+'">'+
  '<p class="muted" style="font-size:12px">Đồng bộ thủ công sẽ quét Trang chính, Bài viết, Ảnh, Video và Reels. Tự động sẽ quét sâu định kỳ và bổ sung metadata xen kẽ.</p>';
}
async function loadItems(){
  const {data}=await api("/api/admin/items?limit=60"); if(!data.ok)return;
  $("#itemsBody").innerHTML=(data.items||[]).map(i=>{
    const thumb=i.r2_thumbnail_key?("/api/media?key="+encodeURIComponent(i.r2_thumbnail_key)):(i.thumbnail_url||"/assets/anhkhoi-cover.webp");
    const caption=(i.caption||"").slice(0,220);
    return '<tr><td><img src="'+esc(thumb)+'" alt="" loading="lazy" style="width:62px;height:84px;object-fit:cover;border-radius:8px;background:#07111f"></td><td><b>'+esc(i.item_type)+'</b><br><span class="pill">'+esc(i.viewLabel||"—")+'</span></td><td>'+(caption?esc(caption):'<span class="muted">Đang chờ lấy caption…</span>')+'<br><button type="button" class="btn alt mini" data-caption-item="'+i.id+'">Sửa caption</button></td><td><select data-item="'+i.id+'"><option '+(i.status==="shadow"?"selected":"")+'>shadow</option><option '+(i.status==="published"?"selected":"")+'>published</option><option '+(i.status==="hidden"?"selected":"")+'>hidden</option><option '+(i.status==="draft"?"selected":"")+'>draft</option></select></td><td>'+(i.permalink?'<a class="muted" target="_blank" rel="noopener" href="'+esc(i.permalink)+'">Mở</a>':"—")+'</td></tr>';
  }).join("")||'<tr><td colspan="5" class="muted">Chưa có dữ liệu.</td></tr>';
  document.querySelectorAll("[data-item]").forEach(el=>el.addEventListener("change",async()=>{await api("/api/admin/items/"+el.dataset.item,{method:"PATCH",body:JSON.stringify({status:el.value})});await loadStats();}));
  document.querySelectorAll("[data-caption-item]").forEach(el=>el.addEventListener("click",async()=>{const item=(data.items||[]).find(x=>String(x.id)===String(el.dataset.captionItem));if(!item)return;const next=prompt("Sửa caption Reel:",item.caption||"");if(next===null)return;const r=await api("/api/admin/items/"+item.id,{method:"PATCH",body:JSON.stringify({caption:next})});if(r.data.ok)await loadItems();}));

}
async function loadRuns(){
  const {data}=await api("/api/admin/runs"); if(!data.ok)return;
  $("#runsBody").innerHTML=(data.runs||[]).map(x=>'<tr><td>'+esc(x.started_at)+'</td><td class="'+(x.status==="success"?"ok":x.status==="blocked"?"bad":"warn")+'">'+esc(x.status)+(x.blocked_reason?'<br><span class="muted">'+esc(x.blocked_reason)+'</span>':"")+'</td><td>'+esc(x.inserted_count)+' / '+esc(x.error_count)+'</td></tr>').join("")||'<tr><td colspan="3" class="muted">Chưa chạy.</td></tr>';
}
async function loadManual(){
  const {data}=await api("/api/admin/manual-posts"); if(!data.ok)return;
  const posts=Array.isArray(data.posts)?data.posts:[];
  $("#manualList").innerHTML=posts.map(p=>{
    const date=p.published_at?String(p.published_at).slice(0,10):"Chưa xuất bản";
    const tags=(p.tags||[]).map(t=>"#"+t).join(" / ");
    const open=p.status==="published"?'<a class="btn alt mini" target="_blank" rel="noopener" href="/bai-viet/?slug='+encodeURIComponent(p.slug)+'">Xem</a>':"";
    const statusLabel=p.status==="published"?"Đã xuất bản":p.status==="archived"?"Lưu trữ":"Bản nháp";
    return '<div class="post-row row between"><div style="flex:1;min-width:200px"><b>'+esc(p.title)+'</b><br>'+
      '<span class="pill">'+esc(statusLabel)+'</span> <span class="pill">'+esc(p.editorial_action||"KEEP")+'</span> '+
      (p.review_required?'<span class="pill warn">Cần review</span> ':"")+
      '<span class="muted">'+esc(date)+' · '+esc(p.category||"Chưa phân loại")+'</span><br>'+
      '<span class="muted">'+esc(tags||"Chưa có tag")+' · '+esc(p.sourceCount||0)+' nguồn · '+esc(p.mediaCount||0)+' ảnh nội dung</span></div>'+
      '<div class="row"><button class="btn alt mini" type="button" data-edit-post="'+p.id+'">Sửa</button>'+
      open+(p.status!=="archived"?'<button class="btn alt mini" type="button" data-toggle-post="'+p.id+'" data-next-status="'+(p.status==="published"?"draft":"published")+'">'+(p.status==="published"?"Ẩn":"Xuất bản")+'</button>':"")+
      '<button class="btn danger mini" type="button" data-remove-post="'+p.id+'">Lưu trữ</button></div></div>';
  }).join("")||"Chưa có bài viết.";
  document.querySelectorAll("[data-edit-post]").forEach(el=>el.addEventListener("click",()=>editPost(el.dataset.editPost)));
  document.querySelectorAll("[data-toggle-post]").forEach(el=>el.addEventListener("click",async()=>{
    const id=el.dataset.togglePost,next=el.dataset.nextStatus;
    const p=posts.find(x=>String(x.id)===id);if(!p)return;
    if(next==="draft"&&!confirm("Ẩn bài \""+p.title+"\" khỏi website? Bạn có thể xuất bản lại bất cứ lúc nào."))return;
    const {data:r}=await saveWithEditorialOverride("/api/admin/manual-posts/"+id,"PATCH",{status:next});
    $("#manualMsg").textContent=r.ok?(next==="draft"?"Đã ẩn bài":"Đã xuất bản bài"):("Lỗi: "+(r.error||""));
    if(r.ok)await loadManual();
  }));
  document.querySelectorAll("[data-remove-post]").forEach(el=>el.addEventListener("click",async()=>{
    const id=el.dataset.removePost;
    const p=posts.find(x=>String(x.id)===id);if(!p)return;
    if(!confirm("Lưu trữ bài \""+p.title+"\"? Bài sẽ ẩn khỏi website công khai nhưng dữ liệu vẫn được giữ."))return;
    const {data:r}=await api("/api/admin/manual-posts/"+id,{method:"DELETE"});
    $("#manualMsg").textContent=r.ok?"Đã lưu trữ bài":("Lỗi: "+(r.error||""));
    if(r.ok){if($("#manualId").value===id)resetManual();await loadManual();}
  }));
}
async function editPost(id){
  const {data}=await api("/api/admin/manual-posts/"+id); if(!data.ok)return;
  const p=data.post;
  $("#manualId").value=p.id;$("#manualTitle").value=p.title||"";$("#manualTitleEn").value=p.title_en||"";$("#manualSlug").value=p.slug||"";
  $("#manualExcerpt").value=p.excerpt||"";$("#manualExcerptEn").value=p.excerpt_en||"";$("#manualCategory").value=p.category||"";
  $("#manualTags").value=(p.tags||[]).join(", ");$("#manualLanguage").value=p.language||"vi";$("#manualBody").value=p.body_markdown||"";$("#manualBodyEn").value=p.body_markdown_en||"";
  $("#manualSources").value=formatPipeRows(p.sources,"source");$("#manualMedia").value=formatPipeRows(p.media,"media");
  $("#manualEditorialAction").value=p.editorial_action||"KEEP";$("#manualEditorialNotes").value=p.editorial_notes||"";
  $("#manualPublishedAt").value=p.published_at?String(p.published_at).slice(0,10):"";$("#manualStatus").value=p.status||"draft";setCover(p.cover_r2_key||"");renderWarnings(p.warnings||[]);
  $("#manualHeading").textContent="Sửa bài viết";$("#deletePostBtn").classList.remove("hidden");
  $("#manualMsg").textContent="Đang sửa #"+p.id;$("#manualForm").scrollIntoView({behavior:"smooth",block:"start"});
}
function resetManual(){
  $("#manualForm").reset();$("#manualId").value="";$("#manualHeading").textContent="Quản lý tất cả bài viết";
  $("#deletePostBtn").classList.add("hidden");$("#manualMsg").textContent="";renderWarnings([]);setCover("");
}
function setCover(key){
  $("#manualCover").value=key||"";const img=$("#manualCoverPreview");
  if(key){img.src="/api/media?key="+encodeURIComponent(key);img.classList.remove("hidden");}
  else{img.removeAttribute("src");img.classList.add("hidden");}
}
function insertMarkdownImage(key){
  const field=$("#manualBody");const url="/api/media?key="+encodeURIComponent(key);const text="\n![Ảnh bài viết]("+url+")\n";
  const start=field.selectionStart??field.value.length,end=field.selectionEnd??field.value.length;
  field.value=field.value.slice(0,start)+text+field.value.slice(end);field.focus();field.selectionStart=field.selectionEnd=start+text.length;
}
async function loadMedia(){
  const {data}=await api("/api/admin/media");if(!data.ok)return;
  $("#mediaGrid").innerHTML=(data.items||[]).map(m=>'<div class="media-item"><img loading="lazy" src="'+esc(m.url)+'" alt=""><div class="media-actions"><button type="button" class="btn alt" data-cover="'+esc(m.key)+'">Làm bìa</button><button type="button" class="btn alt" data-insert="'+esc(m.key)+'">Chèn bài</button><button type="button" class="btn danger" data-delete-media="'+esc(m.key)+'">Xóa</button></div></div>').join("")||'<div class="muted">Chưa có ảnh upload.</div>';
  document.querySelectorAll("[data-cover]").forEach(el=>el.addEventListener("click",()=>setCover(el.dataset.cover)));
  document.querySelectorAll("[data-insert]").forEach(el=>el.addEventListener("click",()=>insertMarkdownImage(el.dataset.insert)));
  document.querySelectorAll("[data-delete-media]").forEach(el=>el.addEventListener("click",async()=>{if(!confirm("Xóa ảnh này khỏi R2? Bài đang dùng ảnh có thể bị mất ảnh."))return;const {data}=await api("/api/admin/media?key="+encodeURIComponent(el.dataset.deleteMedia),{method:"DELETE"});$("#mediaMsg").textContent=data.ok?"Đã xóa ảnh":"Xóa thất bại";if(data.ok)await loadMedia();}));
}
$("#loginForm").addEventListener("submit",async e=>{
  e.preventDefault();
  const msg=$("#loginMsg");
  msg.textContent="Đang xác thực…";
  try{
    const challengeRes=await fetch("/api/admin/challenge",{cache:"no-store",headers:{accept:"application/json"}});
    const challenge=await challengeRes.json().catch(()=>({ok:false,error:"challenge_invalid_response"}));
    if(!challengeRes.ok||!challenge.ok){
      msg.textContent=challenge.error||"Không lấy được thông tin xác thực";
      return;
    }
    const proof=await deriveLoginProof($("#password").value,challenge);
    const {r,data}=await api("/api/admin/login-proof",{
      method:"POST",
      body:JSON.stringify({username:$("#username").value,challengeId:challenge.challengeId,proof})
    });
    if(!r.ok){
      const extra=[data.stage,data.detail].filter(Boolean).join(" · ");
      msg.textContent=(data.error||"Đăng nhập thất bại")+(extra?" · "+extra:"");
      return;
    }
    csrf=data.csrfToken;
    sessionStorage.setItem("ak_csrf",csrf);
    $("#password").value="";
    msg.textContent="";
    await init();
  }catch(err){
    msg.textContent="login_client_error · "+String(err?.message||err);
  }
});
$("#logoutBtn").addEventListener("click",async()=>{await api("/api/admin/logout",{method:"POST"});sessionStorage.removeItem("ak_csrf");csrf="";showLogin();});
$("#syncBtn").addEventListener("click",async()=>{$("#health").textContent="Đang đồng bộ…";const {data}=await api("/api/admin/sync",{method:"POST",body:JSON.stringify({mode:"discover"})});$("#health").textContent=data.ok?"Đồng bộ xong":("Đồng bộ: "+(data.error||data.status||"lỗi"));await refresh();});
$("#enrichBtn").addEventListener("click",async()=>{$("#health").textContent="Đang bổ sung caption…";const {data}=await api("/api/admin/sync",{method:"POST",body:JSON.stringify({mode:"enrich"})});$("#health").textContent=data.ok?("Đã bổ sung "+(data.enriched??0)+" mục"):("Enrich: "+(data.error||data.status||"lỗi"));await refresh();});
$("#saveSettings").addEventListener("click",async()=>{const settings={};document.querySelectorAll("[data-setting]").forEach(el=>settings[el.dataset.setting]=el.type==="checkbox"?String(el.checked):el.value);const {data}=await api("/api/admin/settings",{method:"PATCH",body:JSON.stringify({settings})});$("#settingsMsg").textContent=data.ok?"Đã lưu":"Lỗi";});
$("#passwordForm").addEventListener("submit",async e=>{e.preventDefault();const {data}=await api("/api/admin/password",{method:"POST",body:JSON.stringify({currentPassword:$("#currentPassword").value,newPassword:$("#newPassword").value})});$("#passwordMsg").textContent=data.ok?"Đã đổi mật khẩu":(data.error||"Lỗi");});
$("#manualForm").addEventListener("submit",async e=>{
  e.preventDefault();const id=$("#manualId").value.trim();
  const payload={title:$("#manualTitle").value,titleEn:$("#manualTitleEn").value,slug:$("#manualSlug").value,excerpt:$("#manualExcerpt").value,excerptEn:$("#manualExcerptEn").value,category:$("#manualCategory").value,language:$("#manualLanguage").value,tags:$("#manualTags").value.split(",").map(x=>x.trim()).filter(Boolean),coverR2Key:$("#manualCover").value,bodyMarkdown:$("#manualBody").value,bodyMarkdownEn:$("#manualBodyEn").value,sources:parsePipeRows($("#manualSources").value,"source"),media:parsePipeRows($("#manualMedia").value,"media"),editorialAction:$("#manualEditorialAction").value,editorialNotes:$("#manualEditorialNotes").value,publishedAt:$("#manualPublishedAt").value,status:$("#manualStatus").value};
  const {data}=await saveWithEditorialOverride(id?("/api/admin/manual-posts/"+id):"/api/admin/manual-posts",id?"PATCH":"POST",payload);
  $("#manualMsg").textContent=data.ok?"Đã lưu bài":"Lỗi: "+(data.error||"");
  if(data.ok){resetManual();await loadManual();}
});
$("#newPostBtn").addEventListener("click",resetManual);
$("#deletePostBtn").addEventListener("click",async()=>{const id=$("#manualId").value;if(!id||!confirm("Lưu trữ bài này? Dữ liệu vẫn được giữ trong D1."))return;const {data}=await api("/api/admin/manual-posts/"+id,{method:"DELETE"});$("#manualMsg").textContent=data.ok?"Đã lưu trữ bài":"Lưu trữ thất bại";if(data.ok){resetManual();await loadManual();}});
$("#mediaForm").addEventListener("submit",async e=>{
  e.preventDefault();const file=$("#mediaFile").files?.[0];if(!file){$("#mediaMsg").textContent="Chọn ảnh trước.";return}
  $("#mediaMsg").textContent="Đang upload…";const form=new FormData();form.append("file",file);
  const r=await fetch("/api/admin/media",{method:"POST",headers:csrf?{"x-admin-csrf":csrf}:{},body:form});
  const data=await r.json().catch(()=>({ok:false,error:"invalid_response"}));$("#mediaMsg").textContent=data.ok?"Upload thành công":("Lỗi: "+(data.error||"upload_failed"));
  if(data.ok){$("#mediaFile").value="";setCover(data.key);await loadMedia();}
});
init();
</script>
</body>
</html>
