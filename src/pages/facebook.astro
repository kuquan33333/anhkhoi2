---
import FacebookRuntimeFeed from "../components/FacebookRuntimeFeed.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="Facebook · Bài đăng, ảnh và video" description="Tất cả nội dung Facebook công khai đã được đồng bộ của Anh Khôi: bài viết, ảnh, video và Reels.">
  <section class="card-base p-7 md:p-9 mb-4">
    <span class="text-sm font-bold text-[var(--primary)]">FACEBOOK · BÀI VIẾT & MEDIA</span>
    <h1 class="text-3xl font-extrabold mt-2 mb-3">Bài đăng, ảnh, video và Reels</h1>
    <p class="text-75 leading-8">
      Hiển thị những bài viết, ảnh và video công khai mà hệ thống đã đồng bộ được.
      Chạm vào nút Play ở giữa ảnh để phát video ngay trong khung. Facebook có thể giới hạn
      một số nội dung; khi đó bạn vẫn có thể mở bài gốc bằng liên kết Facebook.
    </p>
  </section>
  <FacebookRuntimeFeed mode="all" />
</MainGridLayout>
