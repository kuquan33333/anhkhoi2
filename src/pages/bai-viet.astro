---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="Bài viết · Anh Khôi AI Media" description="Bài viết do Anh Khôi đăng trực tiếp từ trang quản trị.">
  <article id="ak-live-article" class="card-base relative px-6 md:px-9 pt-6 pb-9 mb-4" aria-label="Nội dung bài viết">
    <nav aria-label="Quay lại danh sách" class="mb-6">
      <a href="/archive/" id="ak-live-back" class="ak-article-back inline-flex items-center gap-2 rounded-xl px-3 py-2 font-bold text-sm">
        <span aria-hidden="true">←</span> Quay lại danh sách bài viết
      </a>
    </nav>
    <div id="ak-live-loading" class="text-75 py-9" role="status">Đang tải bài viết…</div>
    <div id="ak-live-error" class="hidden" role="alert">
      <h1 class="text-2xl font-extrabold">Không tải được bài viết</h1>
      <p id="ak-live-error-text" class="text-75 mt-3">Không tìm thấy bài viết hoặc kết nối gặp sự cố.</p>
      <button type="button" id="ak-live-retry" class="ak-article-back mt-4 font-bold rounded-xl px-4 py-2">Thử tải lại</button>
    </div>
    <div id="ak-live-content" class="hidden">
      <h1 id="ak-live-title" class="ak-article-title text-3xl md:text-4xl font-extrabold leading-tight mt-2 text-90"></h1>
      <div id="ak-live-meta" class="ak-article-meta mt-5 text-sm font-medium"></div>
      <p id="ak-live-excerpt" class="text-75 leading-8 mt-5"></p>
      <figure id="ak-live-figure" class="hidden mt-7 mb-6">
        <img id="ak-live-cover" class="ak-article-cover w-full rounded-xl" alt="" loading="eager" />
      </figure>
      <div id="ak-live-body" class="prose dark:prose-invert prose-base !max-w-none custom-md ak-live-body mt-8" data-pagefind-body></div>
      <div id="ak-live-tags" class="flex flex-wrap gap-2 mt-8"></div>
      <div class="ak-article-footer mt-9 pt-6">
        <a href="/archive/" class="ak-article-back font-bold rounded-xl px-4 py-2 inline-flex items-center gap-2">← Xem các bài viết khác</a>
      </div>
    </div>
  </article>
</MainGridLayout>

<style is:global>
.ak-article-back{color:var(--primary);background:var(--btn-regular-bg);text-decoration:none;transition:background .2s,transform .2s}
.ak-article-back:hover{background:var(--btn-regular-bg-hover)}
.ak-article-back:focus-visible{outline:3px solid var(--primary);outline-offset:2px}
.ak-article-title{position:relative;overflow-wrap:anywhere;line-height:1.3}
.ak-article-title::before{content:"";display:block;position:absolute;width:4px;height:1.4rem;background:var(--primary);border-radius:5px;left:-1.15rem;top:.65rem}
.ak-article-meta{color:var(--text-50);display:flex;flex-wrap:wrap;gap:.7rem;align-items:center}
.ak-article-meta span{background:var(--btn-regular-bg);border-radius:.6rem;padding:.35rem .65rem}
.ak-article-cover{display:block;max-height:38rem;object-fit:contain;background:var(--btn-plain-bg-hover);margin:auto}
.ak-live-body{line-height:1.9;color:var(--text-primary);font-size:1rem;overflow-wrap:anywhere}
.ak-live-body h1,.ak-live-body h2,.ak-live-body h3,.ak-live-body h4{color:var(--text-primary);font-weight:850;line-height:1.38;margin:1.55em 0 .6em}
.ak-live-body h1{font-size:1.85rem}.ak-live-body h2{font-size:1.5rem}.ak-live-body h3{font-size:1.22rem}
.ak-live-body p{margin:1em 0;color:var(--text-primary)}
.ak-live-body strong,.ak-live-body li{color:var(--text-primary)}
.ak-live-body blockquote{border-left:4px solid var(--primary);background:var(--btn-plain-bg-hover);border-radius:.25rem .75rem .75rem .25rem;padding:.7rem 1.1rem;color:var(--text-75)}
.ak-live-body blockquote p{color:var(--text-75)}
.ak-live-body a{color:var(--primary);text-decoration:underline;text-underline-offset:3px}
.ak-live-body img{max-width:100%;height:auto;max-height:75vh;object-fit:contain;margin:1.35rem auto;border-radius:.75rem}
.ak-live-body code{padding:.15em .35em;border-radius:.35rem;background:var(--btn-plain-bg-hover);color:var(--text-primary)}
.ak-live-body pre code{background:transparent;color:inherit}
.ak-live-body table{display:block;overflow-x:auto}
.ak-live-body :focus-visible{outline:2px solid var(--primary);outline-offset:3px}
.ak-article-footer{border-top:1px dashed var(--line-color)}
@media(max-width:640px){.ak-article-title::before{left:-.8rem;height:1rem;top:.45rem}.ak-article-title{font-size:1.7rem}}
</style>