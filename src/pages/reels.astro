---
import FacebookRuntimeFeed from "../components/FacebookRuntimeFeed.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="Video AI & Facebook Reels" description="Thư viện Facebook Reels, video AI và sáng tạo hình ảnh của Anh Khôi.">
  <section class="card-base p-7 md:p-9 mb-4">
    <span class="text-sm font-bold text-[var(--primary)]">REELS / AI STORIES</span>
    <h1 class="text-3xl font-extrabold mt-2 mb-3"
      data-ak-vi="Khám phá video cùng Anh Khôi"
      data-ak-en="Discover videos with Anh Khoi">Khám phá video cùng Anh Khôi</h1>
    <p class="text-75 leading-8"
      data-ak-vi="Reels công khai được hệ thống tự đồng bộ từ Facebook. Video chỉ tải trình phát Facebook khi bạn bấm xem để trang nhẹ hơn trên cả điện thoại và máy tính."
      data-ak-en="Public Reels are synced automatically from Facebook. The Facebook player loads only when you choose to watch, keeping the page lighter on mobile and desktop.">
      Reels công khai được hệ thống tự đồng bộ từ Facebook. Video chỉ tải trình phát Facebook khi bạn bấm xem để trang nhẹ hơn trên cả điện thoại và máy tính.
    </p>
  </section>
  <FacebookRuntimeFeed mode="reels" />
</MainGridLayout>
