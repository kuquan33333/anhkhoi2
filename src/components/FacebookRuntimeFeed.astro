---
interface Props { mode?: "home" | "reels" | "all"; }
const { mode = "home" } = Astro.props;
const isReels = mode === "reels";
const isAll = mode === "all";
---
<section class="ak-runtime-feed card-base p-6 md:p-7 mt-4 hidden"
  data-ak-runtime-feed data-mode={mode}
  aria-label={isReels ? "Facebook Reels tự động" : "Nội dung công khai từ Facebook"}>
  <div class="flex items-center justify-between gap-3 mb-4">
    <div>
      <span class="text-xs font-bold text-[var(--primary)]">FACEBOOK · AUTO SYNC</span>
      <h2 class="text-xl font-extrabold mt-1"
        data-ak-vi={isReels ? "Video và Reels" : isAll ? "Tất cả nội dung đã đồng bộ" : "Mới từ Facebook Anh Khôi"}
        data-ak-en={isReels ? "Videos and Reels" : isAll ? "All synced public content" : "Latest from Anh Khoi on Facebook"}>
        {isReels ? "Video và Reels" : isAll ? "Tất cả nội dung đã đồng bộ" : "Mới từ Facebook Anh Khôi"}
      </h2>
    </div>
    {mode === "home" && <a href="/facebook/" class="text-sm font-bold text-[var(--primary)]">Xem tất cả →</a>}
    {isReels && <a href="/facebook/" class="text-sm font-bold text-[var(--primary)]">Bài viết & ảnh →</a>}
  </div>
  <div class="ak-runtime-grid" data-runtime-grid></div>
  {! (mode === "home") && <div class="ak-runtime-more-wrap">
    <button type="button" class="ak-runtime-more" data-runtime-more hidden>Xem thêm bài đăng</button>
  </div>}
  <p class="ak-runtime-notice hidden" data-runtime-notice role="status"></p>
</section>



<style is:global>
.ak-runtime-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
.ak-runtime-card{background:var(--card-bg);color:var(--text-primary);border:1px solid var(--line-color);border-radius:1rem;overflow:hidden;min-width:0;align-self:start}
.ak-runtime-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:.4rem;background:var(--btn-regular-bg)}
.ak-runtime-poster{display:flex;justify-content:center;align-items:center;min-height:150px;max-height:600px;margin:0}
.ak-runtime-poster img{width:100%;height:auto;max-height:600px;object-fit:contain;display:block}
.ak-runtime-video-stage{display:flex;align-items:center;justify-content:center;background:#0a1428}
.ak-runtime-player-shell{position:relative;display:block;width:100%;max-width:100%;overflow:hidden;background:#0a1428}
.ak-runtime-player-shell.is-reel{width:min(100%,380px)}
.ak-runtime-video-poster{position:absolute;inset:0;background:#0a1428}
.ak-runtime-video-poster img{display:block;width:100%;height:100%;object-fit:contain}
.ak-runtime-overlay-play{position:absolute;inset:0;width:100%;height:100%;border:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;cursor:pointer;background:linear-gradient(180deg,transparent 38%,rgba(0,0,0,.24));color:#fff}
.ak-runtime-overlay-play:hover{background:rgba(0,0,0,.15)}
.ak-runtime-overlay-play:focus-visible{outline:4px solid #fff;outline-offset:-6px}
.ak-runtime-play-icon{display:grid;place-items:center;width:4.8rem;height:4.8rem;min-height:4.8rem;border-radius:50%;font-size:2.1rem;line-height:1;color:#fff;background:rgba(14,54,100,.84);border:2px solid rgba(255,255,255,.9);text-indent:.22rem;box-shadow:0 4px 25px #0008;transition:transform .2s}
.ak-runtime-overlay-play:hover .ak-runtime-play-icon{transform:scale(1.08)}
.ak-runtime-play-caption{background:#07101fcc;color:#fff;border-radius:99px;padding:.38rem .85rem;font-size:.84rem;font-weight:750}
.ak-runtime-video-iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#0a1428}
.ak-runtime-player-close{position:absolute;z-index:2;right:.65rem;top:.65rem;border-radius:99px;border:1px solid #ffffff90;padding:.34rem .75rem;color:#fff;background:#07101fcc;font-size:.78rem;font-weight:750;cursor:pointer}
.ak-runtime-player-close:focus-visible{outline:3px solid #fff;outline-offset:2px}
.ak-runtime-body{padding:1.1rem}
.ak-runtime-meta{font-size:.76rem;font-weight:800;color:var(--primary);letter-spacing:.03em}
.ak-runtime-caption{color:var(--text-primary);margin-top:.75rem;line-height:1.75;font-size:.94rem;white-space:pre-wrap;overflow-wrap:anywhere}
.ak-runtime-actions{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;margin-top:1rem}
.ak-runtime-link{font-size:.84rem;font-weight:750;color:var(--primary);text-decoration:underline;text-underline-offset:3px}
.ak-runtime-post-embed{padding:.5rem 1rem 1rem}
.ak-runtime-post-embed iframe{width:100%;height:600px;max-height:70vh;border:0}
.ak-runtime-more-wrap{display:flex;justify-content:center;margin-top:1.2rem}
.ak-runtime-more{border:1px solid var(--primary);border-radius:99px;padding:.65rem 1.5rem;font-weight:800;color:var(--primary)}
.ak-runtime-more[hidden]{display:none}
.ak-runtime-more:disabled{opacity:.6}
.ak-runtime-notice{font-size:.9rem;padding:1rem;color:var(--text-75)}
@media(max-width:760px){.ak-runtime-grid{grid-template-columns:1fr}.ak-runtime-player-shell.is-reel{width:min(100%,370px)}}
@media(prefers-reduced-motion:reduce){.ak-runtime-play-icon,.ak-runtime-overlay-play{transition:none}}
</style>
