---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <img src={url("/favicon-ak.png")} alt="" width="34" height="34" class="w-[1.9rem] h-[1.9rem] mr-2 rounded-md object-cover" loading="eager" decoding="async" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        <span data-ak-vi={l.name} data-ak-en={l.url==="/"?"Home":l.url==="/archive/"?"Articles":l.url==="/about/"?"About":l.url==="/reels/"?"AI Videos":l.url==="/facebook/"?"Facebook feed":"Facebook"}>{l.name}</span>
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <div class="relative z-50" id="scheme-control">
                <button type="button" aria-label="Chế độ giao diện" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="scheme-switch">
                    <Icon data-theme-icon="light" name="material-symbols:wb-sunny-outline-rounded" class="absolute text-[1.25rem]" />
                    <Icon data-theme-icon="dark" name="material-symbols:dark-mode-outline-rounded" class="absolute text-[1.25rem] hidden" />
                    <Icon data-theme-icon="auto" name="material-symbols:radio-button-partial-outline" class="absolute text-[1.25rem] hidden" />
                </button>
                <div id="light-dark-panel" class="hidden lg:block absolute transition float-panel-closed top-11 -right-2 pt-5">
                    <div class="card-base float-panel p-2">
                        <button type="button" data-theme-choice="light" class="flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95 mb-0.5">
                            <Icon name="material-symbols:wb-sunny-outline-rounded" class="text-[1.25rem] mr-3" /><span data-ak-vi="Sáng" data-ak-en="Light">Sáng</span>
                        </button>
                        <button type="button" data-theme-choice="dark" class="flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95 mb-0.5">
                            <Icon name="material-symbols:dark-mode-outline-rounded" class="text-[1.25rem] mr-3" /><span data-ak-vi="Tối" data-ak-en="Dark">Tối</span>
                        </button>
                        <button type="button" data-theme-choice="auto" class="flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95">
                            <Icon name="material-symbols:radio-button-partial-outline" class="text-[1.25rem] mr-3" /><span data-ak-vi="Theo hệ thống" data-ak-en="System">Theo hệ thống</span>
                        </button>
                    </div>
                </div>
            </div>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
import { AUTO_MODE, DARK_MODE, LIGHT_MODE } from "../constants/constants";
import { applyThemeToDocument, getStoredTheme, setTheme } from "../utils/setting-utils";

type ThemeMode = typeof LIGHT_MODE | typeof DARK_MODE | typeof AUTO_MODE;
const themeSequence: ThemeMode[] = [LIGHT_MODE, DARK_MODE, AUTO_MODE];

function syncThemeControls() {
    const mode = getStoredTheme();
    document.querySelectorAll<HTMLElement>("[data-theme-icon]").forEach(icon => {
        icon.classList.toggle("hidden", icon.dataset.themeIcon !== mode);
    });
    document.querySelectorAll<HTMLElement>("[data-theme-choice]").forEach(button => {
        button.classList.toggle("current-theme-btn", button.dataset.themeChoice === mode);
    });
}

function chooseTheme(mode: string) {
    if (!themeSequence.includes(mode as ThemeMode)) return;
    setTheme(mode as ThemeMode);
    syncThemeControls();
}

function loadButtonScript() {
    const switchBtn = document.getElementById("scheme-switch");
    const schemeControl = document.getElementById("scheme-control");
    const panel = document.getElementById("light-dark-panel");

    if (switchBtn && switchBtn.dataset.boundTheme !== "1") {
        switchBtn.dataset.boundTheme = "1";
        switchBtn.addEventListener("click", () => {
            const current = getStoredTheme();
            const index = Math.max(0, themeSequence.indexOf(current));
            chooseTheme(themeSequence[(index + 1) % themeSequence.length]);
        });
    }
    if (schemeControl && schemeControl.dataset.boundThemePanel !== "1") {
        schemeControl.dataset.boundThemePanel = "1";
        schemeControl.addEventListener("mouseenter", () => panel?.classList.remove("float-panel-closed"));
        schemeControl.addEventListener("mouseleave", () => panel?.classList.add("float-panel-closed"));
    }
    document.querySelectorAll<HTMLElement>("[data-theme-choice]").forEach(button => {
        if (button.dataset.boundThemeChoice === "1") return;
        button.dataset.boundThemeChoice = "1";
        button.addEventListener("click", () => {
            chooseTheme(button.dataset.themeChoice || AUTO_MODE);
            panel?.classList.add("float-panel-closed");
        });
    });

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn && settingBtn.dataset.boundDisplay !== "1") {
        settingBtn.dataset.boundDisplay = "1";
        settingBtn.addEventListener("click", () => {
            document.getElementById("display-setting")?.classList.toggle("float-panel-closed");
        });
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn && menuBtn.dataset.boundMenu !== "1") {
        menuBtn.dataset.boundMenu = "1";
        menuBtn.addEventListener("click", () => {
            document.getElementById("nav-menu-panel")?.classList.toggle("float-panel-closed");
        });
    }
    applyThemeToDocument(getStoredTheme());
    syncThemeControls();
}

const media = window.matchMedia("(prefers-color-scheme: dark)");
if (!(window as any).__akThemeMediaBound) {
    (window as any).__akThemeMediaBound = true;
    media.addEventListener("change", () => {
        if (getStoredTheme() === AUTO_MODE) {
            applyThemeToDocument(AUTO_MODE);
            syncThemeControls();
        }
    });
}

loadButtonScript();
document.addEventListener("swup:page:view", loadButtonScript);
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
