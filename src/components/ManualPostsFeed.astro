---
interface Props { mode?: "home" | "archive"; }
const { mode = "home" } = Astro.props;
---
<section class="ak-manual-feed mt-4 hidden" data-ak-manual-feed data-mode={mode} aria-label="Các bài viết đăng từ quản trị">
  <div class="ak-manual-heading card-base px-6 md:px-9 py-5 mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <span class="text-xs font-bold text-[var(--primary)]">ANH KHÔI · BÀI VIẾT</span>
      <h2 class="text-xl font-extrabold mt-1"
        data-ak-vi="Bài viết mới của Anh Khôi"
        data-ak-en="Latest posts from Anh Khoi">Bài viết mới của Anh Khôi</h2>
    </div>
    {mode === "home" && <a href="/archive/" class="text-sm font-bold text-[var(--primary)]">Xem danh sách →</a>}
  </div>
  <div class="ak-manual-list" data-manual-grid></div>
</section>

<style is:global>
.ak-manual-list{display:flex;flex-direction:column;gap:1rem}
.ak-manual-card{position:relative;display:flex;min-width:0;min-height:195px;border-radius:var(--radius-large);background:var(--card-bg);color:var(--text-primary);overflow:hidden}
.ak-manual-content{padding:1.65rem 2rem;flex:1;min-width:0;max-width:100%}
.ak-manual-card.has-cover .ak-manual-content{padding-right:calc(30% + 1rem)}
.ak-manual-title{font-size:clamp(1.3rem,2vw,1.78rem);line-height:1.35;font-weight:850;letter-spacing:-.02em;overflow-wrap:anywhere}
.ak-manual-title a{color:var(--text-primary);text-decoration:none}
.ak-manual-title a:hover,.ak-manual-title a:focus-visible{color:var(--primary)}
.ak-manual-title::before{content:"";position:absolute;left:1.1rem;top:2rem;width:4px;height:1.15rem;border-radius:4px;background:var(--primary)}
.ak-manual-meta{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;font-size:.8rem;font-weight:650;color:var(--text-50);margin-top:1rem}
.ak-manual-meta .ak-manual-pill{display:inline-flex;align-items:center;border-radius:.45rem;background:var(--btn-regular-bg);padding:.25rem .5rem}
.ak-manual-excerpt{font-size:.93rem;line-height:1.7;color:var(--text-75);margin:.85rem 0 0;overflow-wrap:anywhere}
.ak-manual-link{display:inline-flex;align-items:center;gap:.25rem;font-size:.9rem;font-weight:800;color:var(--primary);margin-top:1rem}
.ak-manual-cover{position:absolute;right:.8rem;top:.8rem;bottom:.8rem;width:28%;display:block;border-radius:.85rem;overflow:hidden;background:var(--btn-regular-bg)}
.ak-manual-cover img{display:block;width:100%;height:100%;object-fit:cover}
.ak-manual-cover:focus-visible,.ak-manual-title a:focus-visible{outline:3px solid var(--primary);outline-offset:2px}
.ak-manual-cover:hover img{transform:scale(1.02);transition:transform .25s}
@media(max-width:760px){
.ak-manual-card{display:flex;flex-direction:column}
.ak-manual-cover{position:relative;order:-1;top:auto;right:auto;bottom:auto;width:auto;aspect-ratio:16/9;margin:.85rem .85rem 0}
.ak-manual-content,.ak-manual-card.has-cover .ak-manual-content{padding:1.3rem 1.4rem}
.ak-manual-title::before{display:none}
}
</style>